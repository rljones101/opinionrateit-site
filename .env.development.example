VITE_API_URL=http://localhost:3000
VITE_APP_NAME=OpinionRateIt
VITE_APP_ENV=development

VITE_STRIPE_KEY=pk_test_your_stripe_publishable_key

# Google OAuth (Sign in with Google) — OAuth 2.0 Client ID ("Web application")
# from Google Cloud Console. Must match GOOGLE_CLIENT_ID on the backend.
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com