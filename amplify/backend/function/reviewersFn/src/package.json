{
  "name": "reviewersfn",
  "version": "1.0.0",
  "description": "Lambda function generated by Amplify",
  "main": "index.js",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "cross-env NODE_ENV=development node dev-server.js",
    "dev:mongo": "cross-env NODE_ENV=development USE_MONGODB=true node dev-server.js",
    "dev:dynamo": "cross-env NODE_ENV=development USE_DYNAMODB=true node dev-server.js",
    "dynamo:start": "java -Djava.library.path=./dynamodb-local/DynamoDBLocal_lib -jar ./dynamodb-local/DynamoDBLocal.jar -sharedDb -port 8000",
    "dynamo:setup": "node scripts/setup-local-dynamodb.js",
    "dynamo:setup:aws": "node scripts/setup-aws-dynamodb.js",
    "dynamo:test": "cross-env NODE_ENV=development USE_DYNAMODB=true node scripts/test-dynamodb.js",
    "dynamo:test:credentials": "node scripts/test-aws-credentials.js",
    "dynamo:admin": "node scripts/dynamo-admin.js",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.928.0",
    "@aws-sdk/client-s3": "^3.928.0",
    "@aws-sdk/lib-dynamodb": "^3.928.0",
    "aws-serverless-express": "^3.4.0",
    "axios": "^1.8.4",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.1.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.2",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "opinionrateit-site": "file:../../../../..",
    "sharp": "^0.34.5",
    "slugify": "^1.6.6",
    "stripe": "^18.0.0",
    "ua-parser-js": "^2.0.6",
    "validator": "^13.15.0",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149"
  }
}
