NODE_ENV=development

# Database Configuration - Choose one or both for testing
USE_MONGODB=false
USE_DYNAMODB=true

# MongoDB Configuration (existing)
DATABASE_USER=root
DATABASE_PASSWORD=example
DATABASE_HOST=localhost
DATABASE_PORT=27017
DATABASE_NAME=orateit-db

# DynamoDB Configuration
# Comment out DYNAMODB_ENDPOINT to use AWS DynamoDB instead of local
DYNAMODB_ENDPOINT=http://localhost:8000
DYNAMODB_REGION=us-east-2
DYNAMODB_TABLE_PREFIX=dev

# AWS Configuration (for S3 and DynamoDB)
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# S3 Configuration
S3_AVATAR_BUCKET=your-s3-bucket-name
CLOUDFRONT_URL=https://your-cloudfront-url

JWT_SECRET=your-jwt-secret-key-minimum-32-characters-long
JWT_EXPIRES_IN=15m
JWT_COOKIE_EXPIRES_IN=7

JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters-long
JWT_REFRESH_EXPIRES_IN=7d

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret

YOUTUBE_API_KEY=your-youtube-api-key
